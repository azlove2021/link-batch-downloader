{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "default",
  "description": "默认能力：窗口、托盘、本地命令",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:event:default",
    "opener:default",
    "dialog:default"
  ]
}
